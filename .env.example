# Local development only. Do not commit real values.
# For a VM/deployment, prefer docker-compose.secrets.example.yml with files under ./secrets/.

SMT_USERNAME=your_smt_username_or_email
SMT_PASSWORD=your_smt_password
SMT_ESIID=your_esiid

# Alternative: point to mounted secret files instead of storing values here.
# SMT_USERNAME_FILE=/run/secrets/smt_username
# SMT_PASSWORD_FILE=/run/secrets/smt_password
# SMT_ESIID_FILE=/run/secrets/smt_esiid

# Runtime settings.
SMT_PROJECT_ROOT=/app
SMT_TIMEZONE=America/Chicago
SMT_REFRESH_TIME=11:00
SMT_OVERLAP_DAYS=7
# Set to 1 if you want scheduler to refresh immediately when the container starts.
SMT_RUN_ON_START=0
